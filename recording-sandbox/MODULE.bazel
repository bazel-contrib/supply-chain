module(
    name = "recording-sandbox",
    version = "HEAD",  # Automatically updated by release pipeline.
)

bazel_dep(name = "rules_go", version = "0.60.0")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "gazelle", version = "0.47.0")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
go_deps.gazelle_override(
    build_file_generation = "clean",
    directives = ["gazelle:proto disable_global"],
    path = "github.com/bazelbuild/remote-apis",
)
use_repo(
    go_deps,
    "com_github_bazelbuild_remote_apis",
    "com_google_cloud_go_longrunning",
    "org_golang_google_genproto_googleapis_bytestream",
    "org_golang_google_genproto_googleapis_rpc",
    "org_golang_google_grpc",
    "org_golang_google_protobuf",
)

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# Official Tracee release bundles, including the static executable and eBPF assets.
http_archive(
    name = "tracee_linux_amd64",
    build_file_content = """filegroup(
    name = "bundle",
    srcs = glob(["dist/**"]),
    visibility = ["//visibility:public"],
)""",
    sha256 = "8cc56bd8c8dd3efadb0441c84849592affc48a71d3afbe7751a9e2014ef9ec85",
    urls = ["https://github.com/aquasecurity/tracee/releases/download/v0.24.1/tracee-x86_64.v0.24.1.tar.gz"],
)

http_archive(
    name = "tracee_linux_arm64",
    build_file_content = """filegroup(
    name = "bundle",
    srcs = glob(["dist/**"]),
    visibility = ["//visibility:public"],
)""",
    sha256 = "adc67c40d5d6d122f81c6a6d0107ad78d51d6be49917929977d77ae720f261ae",
    urls = ["https://github.com/aquasecurity/tracee/releases/download/v0.24.1/tracee-aarch64.v0.24.1.tar.gz"],
)
