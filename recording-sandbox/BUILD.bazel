load("@rules_go//go:def.bzl", "go_binary", "go_test")

config_setting(
    name = "linux_amd64",
    constraint_values = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
)

TRACEE_DATA = select({
    ":linux_amd64": ["@tracee_linux_amd64//:bundle"],
    ":linux_arm64": ["@tracee_linux_arm64//:bundle"],
})

config_setting(
    name = "linux_arm64",
    constraint_values = ["@platforms//os:linux", "@platforms//cpu:aarch64"],
)

go_binary(
    name = "recording-sandbox",
    srcs = [
        "bazel_session.go",
        "bundled_tracee.go",
        "main.go",
        "tracee.go",
    ],
    visibility = ["//visibility:public"],
    data = TRACEE_DATA,
    deps = ["@rules_go//go/runfiles"],
)

go_test(
    name = "recording_sandbox_test",
    srcs = [
        "bazel_session.go",
        "bundled_tracee.go",
        "main.go",
        "main_test.go",
        "tracee.go",
    ],
    data = TRACEE_DATA,
    deps = ["@rules_go//go/runfiles"],
)
