load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "spdx_lib",
    srcs = [
        "license.go",
        "spdx.go",
    ],
    importpath = "github.com/bazel-contrib/supply-chain/lib/supplychain-go/cmd/spdx",
    visibility = ["//visibility:private"],
    deps = [
        "//:supplychain-go",
        "//internal/sbom",
        "@com_github_spdx_tools_golang//spdx/v3/v3_0",
    ],
)

go_binary(
    name = "spdx",
    embed = [":spdx_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "spdx_test",
    srcs = ["spdx_test.go"],
    embed = [":spdx_lib"],
    deps = [
        "//internal/sbom",
        "@com_github_spdx_tools_golang//spdx/v3/v3_0",
    ],
)
