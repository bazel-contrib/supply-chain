module(
    name = "toolchain_demo",
    version = "0.1.0",
)

bazel_dep(name = "package_metadata", version = "0.0.13")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "supply_chain_tools", version = "0.0.1")
bazel_dep(name = "supply-chain-go", version = "0.0.6")
bazel_dep(name = "aspect_rules_js", version = "3.6.1")
bazel_dep(name = "rules_img", version = "0.3.26")
bazel_dep(name = "rules_java", version = "9.9.0")
bazel_dep(name = "rules_nodejs", version = "6.7.7")
bazel_dep(name = "rules_py", version = "2.0.0-alpha.11")
bazel_dep(name = "rules_python", version = "2.5.1")
bazel_dep(
    name = "rules_go",
    version = "0.65.0",
    repo_name = "io_bazel_rules_go",
)
bazel_dep(name = "llvm", version = "0.8.27")
bazel_dep(name = "platforms", version = "1.1.0")

toolchain_involvement = use_extension(
    "@supply_chain_tools//gather_metadata:extensions.bzl",
    "toolchain_involvement",
)
toolchain_involvement.declare(
    name = "demo-openapi-codegen",
    toolchain_type = "@bazel_tools//tools/jdk:toolchain_type",
    rule_kind = "openapi_generate_sources",
    involvement = "build",
)

java_toolchains = use_extension(
    "@rules_java//java:extensions.bzl",
    "toolchains",
)
use_repo(
    java_toolchains,
    "remotejdk21_macos_aarch64",
    "remotejdk25_linux",
)

single_version_override(
    module_name = "llvm",
    patch_strip = 1,
    patches = [
        "//third_party/patches:llvm_cc_toolchain_metadata.patch",
        "//third_party/patches:llvm_cc_runtime_metadata.patch",
        "//third_party/patches:llvm_glibc_build_metadata.patch",
        "//third_party/patches:llvm_glibc_extension_metadata.patch",
        "//third_party/patches:llvm_musl_metadata.patch",
        "//third_party/patches:llvm_toolchain_involvement.patch",
    ],
    version = "0.8.27",
)

single_version_override(
    module_name = "rules_go",
    patch_strip = 1,
    patches = [
        "//third_party/patches:rules_go_sdk_metadata.patch",
        "//third_party/patches:rules_go_bootstrap_sdk_metadata.patch",
        "//third_party/patches:rules_go_toolchain_involvement.patch",
    ],
    version = "0.65.0",
)

single_version_override(
    module_name = "rules_java",
    patch_strip = 1,
    patches = [
        "//third_party/patches:rules_java_jdk_build_metadata.patch",
        "//third_party/patches:rules_java_bootclasspath_visibility.patch",
        "//third_party/patches:rules_java_toolchain_involvement.patch",
    ],
    version = "9.9.0",
)

single_version_override(
    module_name = "rules_nodejs",
    patch_strip = 1,
    patches = [
        "//third_party/patches:rules_nodejs_metadata.patch",
        "//third_party/patches:rules_nodejs_toolchain_involvement.patch",
    ],
    version = "6.7.7",
)

single_version_override(
    module_name = "rules_python",
    patch_strip = 1,
    patches = [
        "//third_party/patches:rules_python_metadata.patch",
        "//third_party/patches:rules_python_toolchain_involvement.patch",
    ],
    version = "2.5.1",
)

local_path_override(
    module_name = "package_metadata",
    path = "../../metadata",
)

local_path_override(
    module_name = "supply-chain-go",
    path = "../../lib/supplychain-go",
)

local_path_override(
    module_name = "supply_chain_tools",
    path = "../../tools",
)

register_toolchains("@llvm//toolchain:all")

register_toolchains(
    "//java:demo_jdk21_compile_toolchain_registration",
    "//java:demo_jdk21_runtime_toolchain",
    "//java:demo_jdk21_bootstrap_runtime_toolchain",
    "//java:demo_jdk25_runtime_toolchain",
)

go_sdk = use_extension(
    "@io_bazel_rules_go//go:extensions.bzl",
    "go_sdk",
)
go_sdk.from_file(
    name = "go_sdk",
    go_mod = "//:go.mod",
)
use_repo(go_sdk, "go_sdk")

node = use_extension(
    "@rules_nodejs//nodejs:extensions.bzl",
    "node",
)
use_repo(node, "nodejs_toolchains")

images = use_extension("@rules_img//img:extensions.bzl", "images")
images.pull(
    name = "ubuntu_24_04",
    digest = "sha256:1e622c5f073b4f6bfad6632f2616c7f59ef256e96fe78bf6a595d1dc4376ac02",
    registry = "index.docker.io",
    repository = "library/ubuntu",
    tag = "24.04",
)
use_repo(images, "rules_img_images.bzl")
