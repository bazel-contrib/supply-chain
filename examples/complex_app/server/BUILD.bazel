load("@io_bazel_rules_go//go:def.bzl", "go_binary")
load("@package_metadata//rules:package_metadata.bzl", "package_metadata")

package(
    default_package_metadata = [":package_metadata"],
    default_visibility = ["//visibility:public"],
)

package_metadata(
    name = "package_metadata",
    purl = "pkg:generic/toolchain-demo-server@0.1.0",
)

go_binary(
    name = "server",
    srcs = [
        "//:openapi_generated.go",
        "//:server.go",
    ],
    cdeps = select({
        "//:glibc_dynamic_cgo": ["//cgo_resolver/dynamic_link:resolver_dynamic_deps"],
        "//conditions:default": ["//cgo_resolver:resolver"],
    }),
    cgo = True,
    data = select({
        "//:glibc_dynamic_cgo": [
            "//cgo_resolver/shared:resolver_shared",
            "@@llvm++glibc+glibc_2.28//:runtime_dependency",
        ],
        "//:libc_glibc": ["@@llvm++glibc+glibc_2.28//:runtime_dependency"],
        "//:libc_musl": [],
    }),
    embedsrcs = [
        "//:frontend.js",
        "//:web/index.html",
    ],
    importpath = "example.com/complex-app",
    static = select({
        "//:libc_glibc": "off",
        "//:libc_musl": "on",
    }),
    target_compatible_with = select({
        "//:musl_dynamic_cgo": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)
