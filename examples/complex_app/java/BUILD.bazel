load("@rules_java//java:defs.bzl", "java_binary")

package(default_visibility = ["//visibility:public"])

toolchain(
    name = "runtime_jdk21_macos",
    target_compatible_with = [
        "@platforms//cpu:arm64",
        "@platforms//os:macos",
    ],
    toolchain = "@remotejdk21_macos_aarch64//:jdk",
    toolchain_type = "@bazel_tools//tools/jdk:runtime_toolchain_type",
)

toolchain(
    name = "runtime_jdk25_linux",
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    toolchain = "@remotejdk25_linux//:jdk",
    toolchain_type = "@bazel_tools//tools/jdk:runtime_toolchain_type",
)

java_binary(
    name = "openapi_codegen_tool",
    srcs = ["codegen/OpenApiGenerator.java"],
    main_class = "demo.codegen.OpenApiGenerator",
)

java_binary(
    name = "runtime_java",
    srcs = ["runtime/JavaGreeter.java"],
    main_class = "demo.runtime.JavaGreeter",
)
