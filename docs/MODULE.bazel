module(
    name = "supply-chain-docs",
    version = "HEAD",
)

# Must come first so that its C++ toolchain takes precedence over the one from
# `rules_cc`, which doesn't support newer versions of Xcode.
bazel_dep(
    name = "apple_support",
    version = "2.10.1",
)
bazel_dep(
    name = "bazel_skylib",
    version = "1.9.2",
)
bazel_dep(
    name = "stardoc",
    version = "0.8.1",
)
bazel_dep(
    name = "protobuf",
    version = "36.1.bcr.1",
)
bazel_dep(
    name = "llvm",
    version = "0.8.25",
)

register_toolchains("@llvm//toolchain:all")

#
# Modules from this repository.
#

# Resolved to the local sources by the registry in //registry/head (see .bazelrc).
bazel_dep(
    name = "package_metadata",
    version = "HEAD",
)
bazel_dep(
    name = "package_metadata_extensions",
    version = "HEAD",
)
bazel_dep(
    name = "supply_chain_tools",
    version = "HEAD",
)
bazel_dep(
    name = "supply-chain-go",
    version = "HEAD",
)
