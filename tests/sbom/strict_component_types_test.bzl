"""Tests of --//sbom:strict_component_types.

The metadata of a component can be generated by an action, so the check runs in
the SbomClassify action rather than at analysis time. The flag wiring is
checked by analysis tests, and the check itself by running the tool.
"""

load("@bazel_skylib//lib:unittest.bzl", "analysistest", "asserts")
load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@supply_chain_tools//sbom:providers.bzl", "SbomInfo")

_strict_flag = str(Label("@supply_chain_tools//sbom:strict_component_types"))

def _classify_args(env):
    for action in analysistest.target_actions(env):
        if action.mnemonic == "SbomClassify":
            return action.argv
    fail("no SbomClassify action found")

def _passes_flag_test_impl(ctx):
    env = analysistest.begin(ctx)
    asserts.true(env, "--strict_component_types" in _classify_args(env))
    return analysistest.end(env)

def _omits_flag_test_impl(ctx):
    env = analysistest.begin(ctx)
    asserts.false(env, "--strict_component_types" in _classify_args(env))
    return analysistest.end(env)

_passes_flag_test = analysistest.make(
    _passes_flag_test_impl,
    config_settings = {_strict_flag: True},
)

_omits_flag_test = analysistest.make(
    _omits_flag_test_impl,
    config_settings = {_strict_flag: False},
)

def _check_impl(ctx):
    out = ctx.actions.declare_file(ctx.label.name + ".ok")
    ctx.actions.run_shell(
        outputs = [out],
        inputs = depset(
            [ctx.attr.sbom[SbomInfo].graph],
            transitive = [ctx.attr.sbom[DefaultInfo].files],
        ),
        tools = [ctx.attr._sbom_cmd[DefaultInfo].files_to_run],
        command = """
if "$1" --input "$2" --output "$3.classifications" --strict_component_types 2> "$3.stderr"; then
  if [ -n "$4" ]; then
    echo "the tool was expected to fail on $2" >&2
    exit 1
  fi
elif [ -z "$4" ] || ! grep -qF -- "$4" "$3.stderr"; then
  echo "the tool failed without the expected message: $4" >&2
  cat "$3.stderr" >&2
  exit 1
fi
: > "$3"
""",
        arguments = [
            ctx.executable._sbom_cmd.path,
            ctx.attr.sbom[SbomInfo].graph.path,
            out.path,
            ctx.attr.message,
        ],
    )
    return [DefaultInfo(files = depset([out]))]

_strict_check = rule(
    _check_impl,
    attrs = {
        "sbom": attr.label(mandatory = True, providers = [SbomInfo]),
        "message": attr.string(doc = "Text the tool must print when it fails. Empty if it must succeed."),
        "_sbom_cmd": attr.label(
            default = "@supply-chain-go//cmd/sbom",
            executable = True,
            cfg = "exec",
        ),
    },
)

def strict_component_types_test_suite(name, untyped_sbom, typed_sbom):
    """Tests of --//sbom:strict_component_types.

    Args:
      name: name of the test suite.
      untyped_sbom: an `sbom` target whose graph has a component without a component_type.
      typed_sbom: an `sbom` target whose components all declare a component_type.
    """
    _passes_flag_test(name = name + "_flag_set", target_under_test = untyped_sbom)
    _omits_flag_test(name = name + "_flag_unset", target_under_test = untyped_sbom)

    _strict_check(
        name = name + "_untyped_check",
        message = "do not declare a component_type attribute: //sbom/edge_cases:image_library",
        sbom = untyped_sbom,
    )
    _strict_check(
        name = name + "_typed_check",
        sbom = typed_sbom,
    )
    build_test(
        name = name + "_checks",
        targets = [
            name + "_untyped_check",
            name + "_typed_check",
        ],
    )

    native.test_suite(
        name = name,
        tests = [
            name + "_flag_set",
            name + "_flag_unset",
            name + "_checks",
        ],
    )
