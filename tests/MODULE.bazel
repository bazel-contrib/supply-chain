module(
    name = "supply_chain_tests",
    version = "",  # Automatically updated by release pipeline.
)

bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "jq.bzl", version = "0.7.1")
bazel_dep(name = "rules_testing", version = "0.9.0")
bazel_dep(name = "bazel_features", version = "1.51.0")
bazel_dep(name = "package_metadata", version = "HEAD")
bazel_dep(name = "package_metadata_extensions", version = "HEAD")
bazel_dep(name = "rules_license", version = "1.0.0")
bazel_dep(name = "supply-chain-go", version = "HEAD")
bazel_dep(name = "supply_chain_tools", version = "HEAD")
bazel_dep(name = "supply_chain_examples", version = "HEAD")
bazel_dep(name = "toolchain_fixtures", version = "1.0.0")

local_path_override(
    module_name = "package_metadata",
    path = "../metadata",
)

local_path_override(
    module_name = "package_metadata_extensions",
    path = "../metadata-extensions",
)

local_path_override(
    module_name = "rules_license",
    path = "../rules_license",
)

local_path_override(
    module_name = "supply-chain-go",
    path = "../lib/supplychain-go",
)

local_path_override(
    module_name = "supply_chain_tools",
    path = "../tools",
)

local_path_override(
    module_name = "supply_chain_examples",
    path = "../examples",
)

# Fictional packages the examples depend on.
[
    local_path_override(
        module_name = module,
        path = "../external_packages/" + module,
    )
    for module in [
        "acme_plugin",
        "acme_sdk",
        "classpath_runtime",
        "crypto_suite",
        "dual_licensed",
        "legacy_gpl",
        "toolchain_fixtures",
    ]
]

toolchain_involvement = use_extension(
    "@supply_chain_tools//gather_metadata:extensions.bzl",
    "toolchain_involvement",
)
toolchain_involvement.declare(
    name = "root-override-binary",
    toolchain_type = "@toolchain_fixtures//:root_override_type",
    rule_kind = "root_override_binary",
    involvement = "runtime",
)
toolchain_involvement.declare(
    name = "cycle-backedge-toolchain",
    toolchain_type = "//sbom/edge_cases:cycle_backedge_type",
    rule_kind = "cycle_backedge_binary",
    involvement = "runtime",
)

toolchain_involvement.declare(
    name = "py-image-layer-python",
    toolchain_type = "@bazel_tools//tools/python:toolchain_type",
    rule_kind = "py_image_layer",
    involvement = "embedded",
)
toolchain_involvement.declare(
    name = "py-image-layer-tar",
    toolchain_type = "@toolchain_fixtures//:tar_toolchain_type",
    rule_kind = "py_image_layer",
    involvement = "build",
)
toolchain_involvement.declare(
    name = "cc-binary-llvm",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
    rule_kind = "cc_binary",
    involvement = "embedded",
)
toolchain_involvement.declare(
    name = "cc-library-llvm",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
    rule_kind = "cc_library",
    involvement = "embedded",
)
toolchain_involvement.declare(
    name = "cc-test-llvm",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
    rule_kind = "cc_test",
    involvement = "embedded",
)
toolchain_involvement.declare(
    name = "openapi-java",
    toolchain_type = "@bazel_tools//tools/jdk:toolchain_type",
    rule_kind = "openapi_generate_sources",
    involvement = "build",
)

register_toolchains(
    "@toolchain_fixtures//:java_jre_toolchain",
    "@toolchain_fixtures//:javac_toolchain",
    "@toolchain_fixtures//:python_toolchain",
    "@toolchain_fixtures//:node_runtime_toolchain",
    "@toolchain_fixtures//:node_transpiler_toolchain",
    "@toolchain_fixtures//:llvm_runtime_toolchain",
    "@toolchain_fixtures//:dual_jdk_runtime_toolchain",
    "@toolchain_fixtures//:mixed_build_toolchain",
    "@toolchain_fixtures//:mixed_runtime_toolchain",
    "@toolchain_fixtures//:mixed_embedded_toolchain",
    "@toolchain_fixtures//:image_tar_toolchain",
    "@toolchain_fixtures//:root_override_toolchain",
    "//sbom/edge_cases:cycle_backedge_toolchain",
)
