# Tests for `@package_metadata` that need a dependency (e.g. `bazel_skylib`).
#
# This is a module of its own (ignored by `../.bazelignore`) so that
# `@package_metadata` ships without any dependency: consumers -- including the
# BCR presubmit -- build `@package_metadata//...` as a non-root module, where
# its `dev_dependency`s are not resolved.
#
# Run with `bazel test //... @package_metadata//...` to also build the module
# under test from an external standpoint.
module(
    name = "package_metadata_tests",
)

bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "package_metadata", version = "HEAD")
local_path_override(
    module_name = "package_metadata",
    path = "..",
)
